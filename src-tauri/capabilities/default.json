{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "默认能力",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "store:default",
    "dialog:default",
    "core:window:allow-set-theme",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://raw.githubusercontent.com/*" },
        { "url": "https://cdn.jsdelivr.net/*" }
      ]
    }
  ]
}
